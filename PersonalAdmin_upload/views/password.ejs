<%- include('partials/head', { title: '账号安全' }) %>
<div class="layout">
  <%- include('partials/sidebar', { page: page }) %>
  <main class="main">
    <header class="page-head">
      <h1>账号安全</h1>
      <p>修改登录密码，新密码至少 8 位</p>
    </header>

    <% if (flash) { %>
      <div class="flash <%= flash.type %>"><%= flash.text %></div>
    <% } %>

    <section class="card narrow">
      <h2 class="card-title">修改密码</h2>
      <form action="/password" method="post" class="form">
        <label class="field">
          <span>原密码 <em>*</em></span>
          <input type="password" name="old_password" placeholder="请输入当前密码" required>
        </label>
        <label class="field">
          <span>新密码 <em>*</em></span>
          <input type="password" name="new_password" placeholder="至少 8 位" minlength="8" required>
        </label>
        <label class="field">
          <span>确认新密码 <em>*</em></span>
          <input type="password" name="confirm_password" placeholder="再次输入新密码" minlength="8" required>
        </label>
        <div class="form-actions">
          <button class="btn primary" type="submit">保存新密码</button>
        </div>
      </form>
    </section>
  </main>
</div>
</body>
</html>
